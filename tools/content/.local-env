# Machine-local settings for run.sh (safe to commit: no secrets). Persistent, outside the iCloud-synced
# Desktop: the content cache (image cache, candidate pools, contact sheets, openverse budget) and the
# Python venv live in ~/.local/share/card-jigsaw-world/. The repo-root .venv is a symlink to that venv.
export CJW_CONTENT_CACHE="$HOME/.local/share/card-jigsaw-world/content-cache"
export CJW_PY="$HOME/.local/share/card-jigsaw-world/venv/bin/python"
